<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:gacha="using:Starward.Features.Gacha"
             x:Class="Starward.Features.ViewHost.GachaView"
             x:DataType="local:GachaViewModel"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="card" Padding="18,14">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="UID" Classes="secondary" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Uids}"
                              SelectedItem="{Binding SelectedUid, Mode=TwoWay}"
                              MinWidth="150" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button Classes="cta" Command="{Binding RefreshCommand}" Content="Update" />
                    <Button Command="{Binding ImportUrlCommand}" Content="Import URL" />
                    <Button Command="{Binding ImportAllCommand}" Content="Fetch all" />
                    <Button Command="{Binding ExportCommand}" Content="Export" />
                    <Button Command="{Binding ImportFileCommand}" Content="Import file" />
                    <Button Classes="ghost" Command="{Binding DeleteUidCommand}" Content="Delete UID" />
                </StackPanel>

                <ProgressBar Grid.Column="2"
                             IsIndeterminate="True"
                             Width="120"
                             Margin="18,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsBusy}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding ProgressText}"
                           Classes="tertiary"
                           MaxWidth="340"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33EB5757"
                CornerRadius="8"
                Padding="12,9"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="#FFD8D8" FontSize="13" />
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Spacing="18">
                <TextBlock Text="Overview" Classes="h2" IsVisible="{Binding HasData}" />

                <ItemsControl ItemsSource="{Binding Stats}" IsVisible="{Binding HasData}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="310" ItemHeight="200" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gacha:GachaTypeStats">
                            <Border Classes="card" Margin="0,0,14,14" Padding="18">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding GachaTypeText}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid Grid.Row="1"
                                          Margin="0,14"
                                          ColumnDefinitions="*,*,*"
                                          VerticalAlignment="Center">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Pulls" Classes="tertiary" />
                                            <TextBlock Text="{Binding Count}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="5★ / 4★" Classes="tertiary" />
                                            <TextBlock FontSize="22" FontWeight="SemiBold">
                                                <Run Text="{Binding Count_5}" />
                                                <Run Text=" / " Foreground="#88FFFFFF" />
                                                <Run Text="{Binding Count_4}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Pity" Classes="tertiary" />
                                            <TextBlock Text="{Binding Pity_5}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Classes="tertiary"
                                                   Text="{Binding StartTime, StringFormat='From {0:yyyy-MM-dd}'}" />
                                        <TextBlock Classes="tertiary"
                                                   Text="{Binding Ratio_5, StringFormat='5★ rate {0:P2}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Rare drops" Classes="h2" IsVisible="{Binding HasData}" />
                <ItemsControl ItemsSource="{Binding RecentFiveStars}" IsVisible="{Binding HasData}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gacha:GachaLogItemEx">
                            <Border Classes="card"
                                    Margin="0,0,10,10"
                                    Padding="12"
                                    MinWidth="190">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                Background="#33FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RankType}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Classes="tertiary"
                                               Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                    <TextBlock Classes="tertiary"
                                               Text="{Binding Pity, StringFormat='Pity {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="card"
                        IsVisible="{Binding !HasData}"
                        Padding="30"
                        Margin="0,10,0,0">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Classes="h2" />
                        <TextBlock Text="{Binding EmptyText}" Classes="secondary" />
                        <TextBlock Classes="tertiary"
                                   Text="The game must be installed and the in-game history page opened at least once so the authkey exists in its web cache. You can also paste the URL manually." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
