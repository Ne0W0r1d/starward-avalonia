<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:gacha="using:Starward.Features.Gacha"
             xmlns:i18n="using:Starward.I18n"
             x:Class="Starward.Features.ViewHost.GachaView"
             x:DataType="local:GachaViewModel"
             mc:Ignorable="d">

    <Grid Margin="24,0,24,20" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="card" Padding="18,12">
            <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                Margin="0,0,16,6"
                                VerticalAlignment="Center">
                        <TextBlock Text="UID" Classes="secondary" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Uids}"
                                  SelectedItem="{Binding SelectedUid, Mode=TwoWay}"
                                  MinWidth="138" />
                    </StackPanel>
                    <Button Classes="cta"
                            Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding RefreshCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_UpdateRecords}" />
                    <Button Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding ImportFromGameCacheCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_ReadCache}" />
                    <Button Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding ImportUrlCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_ImportUrl}" />
                    <Button Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding ImportAllCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_FetchAll}" />
                    <Button Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding ExportCommand}"
                            Content="{i18n:Tr Key=GachaImportAndExportWindow_Export}" />
                    <Button Padding="11,6"
                            Margin="0,0,6,6"
                            Command="{Binding ImportFileCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_ImportFile}" />
                    <Button Classes="ghost"
                            Padding="9,6"
                            Margin="0,0,6,6"
                            Command="{Binding DeleteUidCommand}"
                            Content="{i18n:Tr Key=Avalonia_Gacha_DeleteUid}" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding CacheStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource SuccessBrush}"
                                 IsVisible="{Binding HasGameCache}" />
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource TertiaryTextBrush}"
                                 IsVisible="{Binding !HasGameCache}" />
                        <TextBlock Text="{Binding CacheStatusText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="78"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressText}"
                               Classes="tertiary"
                               MaxWidth="260"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Background="#33EB5757"
                CornerRadius="8"
                Padding="12,9"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="#FFD8D8" FontSize="13" />
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Spacing="18">
                <TextBlock Text="{i18n:Tr Key=Avalonia_Gacha_Overview}" Classes="h2" IsVisible="{Binding HasData}" />

                <ItemsControl ItemsSource="{Binding Stats}" IsVisible="{Binding HasData}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="310" ItemHeight="200" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gacha:GachaTypeStats">
                            <Border Classes="card" Margin="0,0,14,14" Padding="18">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding GachaTypeText}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Grid Grid.Row="1"
                                          Margin="0,14"
                                          ColumnDefinitions="*,*,*"
                                          VerticalAlignment="Center">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{i18n:Tr Key=Avalonia_Gacha_Pulls}" Classes="tertiary" />
                                            <TextBlock Text="{Binding Count}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="5★ / 4★" Classes="tertiary" />
                                            <TextBlock FontSize="22" FontWeight="SemiBold">
                                                <Run Text="{Binding Count_5}" />
                                                <Run Text=" / " Foreground="#88FFFFFF" />
                                                <Run Text="{Binding Count_4}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="{i18n:Tr Key=GachaStatsCard_Pity}" Classes="tertiary" />
                                            <TextBlock Text="{Binding Pity_5}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Classes="tertiary"
                                                   Text="{Binding StartTime, StringFormat={i18n:Tr Key=Avalonia_Gacha_FromDate}}" />
                                        <TextBlock Classes="tertiary"
                                                   Text="{Binding Ratio_5, StringFormat={i18n:Tr Key=Avalonia_Gacha_FiveStarRate}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{i18n:Tr Key=Avalonia_Gacha_RareDropsByBanner}" Classes="h2" IsVisible="{Binding HasData}" />
                <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasData}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gacha:GachaCategoryGroup">
                            <Border Classes="card"
                                    Margin="0,0,0,14"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RareCount, StringFormat={i18n:Tr Key=Avalonia_Gacha_RareCountFormat}}"
                                                   Classes="tertiary"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{i18n:Tr Key=Avalonia_Gacha_NoRareItems}"
                                               Classes="tertiary"
                                               IsVisible="{Binding !HasRareItems}" />

                                    <ItemsControl ItemsSource="{Binding RareItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gacha:GachaLogItemEx">
                                                <Border Background="#1FFFFFFF"
                                                        CornerRadius="8"
                                                        Padding="10"
                                                        Margin="0,0,8,8"
                                                        MinWidth="184">
                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Width="22"
                                                                    Height="22"
                                                                    CornerRadius="11"
                                                                    Background="#33FFFFFF"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RankType}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Classes="tertiary"
                                                                   Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                                        <TextBlock Classes="tertiary"
                                                                   Text="{Binding Pity, StringFormat={i18n:Tr Key=Avalonia_Gacha_PityFormat}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="card"
                        IsVisible="{Binding !HasData}"
                        Padding="30"
                        Margin="0,10,0,0">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Classes="h2" />
                        <TextBlock Text="{Binding EmptyText}" Classes="secondary" />
                        <TextBlock Classes="tertiary"
                                   Text="{i18n:Tr Key=Avalonia_Gacha_EmptyBody}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Classes="cta"
                                    Command="{Binding ImportFromGameCacheCommand}"
                                    Content="{i18n:Tr Key=Avalonia_Gacha_ReadFromCache}" />
                            <Button Command="{Binding ImportUrlCommand}" Content="{i18n:Tr Key=Avalonia_Gacha_PasteUrl}" />
                            <Button Classes="ghost"
                                    Command="{Binding RefreshCommand}"
                                    Content="{i18n:Tr Key=Avalonia_Gacha_UpdateRecords}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
