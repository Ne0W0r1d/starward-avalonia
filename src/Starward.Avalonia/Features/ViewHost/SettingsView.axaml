<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:compat="using:Starward.Features.Compatibility"
             x:Class="Starward.Features.ViewHost.SettingsView"
             x:DataType="local:SettingsViewModel"
             mc:Ignorable="d">

    <TabControl TabStripPlacement="Left"
                Background="#A61B1B1F"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.Styles>
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinWidth" Value="190" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </TabControl.Styles>

        <!-- General -->
        <TabItem Header="General">
            <ScrollViewer>
                <StackPanel Spacing="6" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="General" Classes="h1" />
                    <TextBlock Text="Language and everyday behaviour of the launcher." Classes="secondary" />

                    <TextBlock Text="Language" Classes="section" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Width="280" />
                    <Border Background="#26F2C94C"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,10,0,0"
                            IsVisible="{Binding NeedsRestart}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="Restart Starward to apply the language / data folder change."
                                       Foreground="#FFF3D2"
                                       VerticalAlignment="Center" />
                            <Button Classes="cta"
                                    Command="{Binding RestartCommand}"
                                    Content="Restart" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Behaviour" Classes="section" />
                    <CheckBox IsChecked="{Binding AutoDetectGames, Mode=TwoWay}"
                              Content="Automatically detect installed games when opening the launcher" />
                    <CheckBox IsChecked="{Binding EnablePreviewRelease, Mode=TwoWay}"
                              Content="Receive preview release information" />

                    <TextBlock Text="Screenshots" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="560">
                        <TextBox Text="{Binding ScreenshotFolder, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Command="{Binding BrowseScreenshotFolderCommand}"
                                Content="Browse" />
                    </Grid>
                    <TextBlock Text="Starward also keeps screenshots captured through the app in a per-game subfolder here."
                               Classes="tertiary" />
                    <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="#33EB5757"
                            CornerRadius="8"
                            Padding="12,9">
                        <TextBlock Text="{Binding Error}" Foreground="#FFD8D8" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Linux compatibility -->
        <TabItem Header="Linux compatibility">
            <ScrollViewer>
                <StackPanel Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Linux compatibility" Classes="h1" />
                    <TextBlock Classes="secondary"
                               Text="Detect Wine and Proton installations, choose the layer used to launch each game, and set the prefix directory." />

                    <Border IsVisible="{Binding !IsLinux}"
                            Background="#1FFFFFFF"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,14,0,0">
                        <TextBlock Text="This section is only relevant on Linux. On Windows the game is launched natively."
                                   Classes="secondary" />
                    </Border>

                    <StackPanel Spacing="6" IsVisible="{Binding IsLinux}">
                        <TextBlock Text="Detected compatibility layers" Classes="section" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <ComboBox ItemsSource="{Binding CompatLayers}"
                                      SelectedItem="{Binding SelectedCompatLayer, Mode=TwoWay}"
                                      PlaceholderText="No compatibility layer detected"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="compat:CompatLayer">
                                        <StackPanel Spacing="1" Margin="2,3">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Classes="tertiary">
                                                <Run Text="{Binding KindText}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SourceText}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ExecutablePath}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshCompatCommand}"
                                    Content="Scan again" />
                        </Grid>
                        <TextBlock Text="{Binding CompatStatusText}" Classes="tertiary" />

                        <TextBlock Text="Current game" Classes="section" />
                        <Border Classes="card" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding CurrentGameName}" FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Prefix folder" Classes="tertiary" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding CurrentGamePrefix, Mode=OneWay}" IsReadOnly="True" />
                                        <Button Grid.Column="1" Command="{Binding BrowseGamePrefixCommand}" Content="Browse" />
                                        <Button Grid.Column="2" Classes="ghost" Command="{Binding ResetGamePrefixCommand}" Content="Default" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Prefix root" Classes="section" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding WinePrefixRoot, Mode=TwoWay}" />
                            <Button Grid.Column="1" Command="{Binding BrowsePrefixRootCommand}" Content="Browse" />
                        </Grid>
                        <TextBlock Text="Each game uses a subfolder named after its GameBiz unless a custom prefix is selected above."
                                   Classes="tertiary" />

                        <TextBlock Text="Launch options" Classes="section" />
                        <TextBlock Text="Extra arguments passed to the game executable" Classes="tertiary" />
                        <TextBox Text="{Binding CompatExtraArguments, Mode=TwoWay}"
                                 Watermark="-dx11 / custom flags" />
                        <CheckBox IsChecked="{Binding CompatDisableMenuBuilder, Mode=TwoWay}"
                                  Content="Disable Wine menu builder (WINEDLLOVERRIDES=winemenubuilder.exe=d)" />

                        <TextBlock Text="Additional scan paths" Classes="section" />
                        <TextBlock Text="One path per line. Point to a compatibilitytools.d directory, a Proton folder, or a Wine runner with bin/wine."
                                   Classes="tertiary" />
                        <TextBox Text="{Binding CompatScanPaths, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 MinHeight="82"
                                 TextWrapping="Wrap" />

                        <Border Background="#1FFFFFFF" CornerRadius="10" Padding="16" Margin="0,10,0,0">
                            <TextBlock Classes="secondary">
                                Proton prefixes are passed through STEAM_COMPAT_DATA_PATH; Wine prefixes use WINEPREFIX.
                                Do not point two games at the same mutable prefix unless you really intend to share it.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Download -->
        <TabItem Header="Download">
            <ScrollViewer>
                <StackPanel Spacing="6" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Download" Classes="h1" />
                    <TextBlock Text="Network preferences used by future download and update support." Classes="secondary" />
                    <TextBlock Text="Speed limit (KB/s, 0 = unlimited)" Classes="section" />
                    <NumericUpDown Value="{Binding SpeedLimitKBPerSecond, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="1048576"
                                   Increment="512"
                                   Width="260" />
                    <Border Background="#1FFFFFFF" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                        <TextBlock Classes="secondary"
                                   Text="In-place game download, verification and update are driven by the Windows RPC installer in the original project. The Avalonia build keeps the preference and version checks, but game files must currently be updated with the official launcher or your Wine prefix tooling." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Advanced -->
        <TabItem Header="Advanced">
            <ScrollViewer>
                <StackPanel Spacing="6" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Advanced" Classes="h1" />
                    <TextBlock Text="Data, backups and diagnostics." Classes="secondary" />

                    <TextBlock Text="Data folder" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                        <Button Grid.Column="1" Command="{Binding ChangeDataFolderCommand}" Content="Change" />
                        <Button Grid.Column="2" Command="{Binding OpenDataFolderCommand}" Content="Open" />
                    </Grid>
                    <TextBlock Classes="tertiary" Text="{Binding CacheFolder, StringFormat='App data: {0}'}" />
                    <TextBlock Classes="tertiary" Text="{Binding LogFile, StringFormat='Log: {0}'}" />

                    <TextBlock Text="Maintenance" Classes="section" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding BackupDatabaseCommand}" Content="Backup database" />
                        <Button Command="{Binding OpenLogCommand}" Content="Open log" />
                        <Button Classes="ghost" Command="{Binding ResetSettingsCommand}" Content="Reset settings" />
                    </StackPanel>

                    <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="#33EB5757"
                            CornerRadius="8"
                            Padding="12,9">
                        <TextBlock Text="{Binding Error}" Foreground="#FFD8D8" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- About -->
        <TabItem Header="About">
            <ScrollViewer>
                <StackPanel Spacing="8" MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="Starward" Classes="h1" />
                    <TextBlock Text="An open-source alternative launcher for HoYoverse PC games." Classes="secondary" />
                    <TextBlock Text="{Binding Version, StringFormat='Avalonia port · Version {0}'}" Classes="secondary" />
                    <TextBlock Text="{Binding DotnetVersion, StringFormat='.NET {0}'}" Classes="tertiary" />

                    <Border Classes="card" Padding="18" Margin="0,18,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Migration status" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary"
                                       Text="The UI has been rebuilt with Avalonia. Launcher, Wine/Proton detection and launch, gacha records, screenshots and play-time tracking are ported. Windows-only features such as the RPC installer, registry account switching, gamepad emulation and HDR screenshot processing are not yet available." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://github.com/Scighost/Starward"
                                Content="Starward on GitHub" />
                        <Button Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://docs.avaloniaui.net/docs"
                                Content="Avalonia documentation" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
