<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:pt="using:Starward.Features.PlayTime"
             x:Class="Starward.Features.ViewHost.PlayTimeView"
             x:DataType="local:PlayTimeViewModel"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="card" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding CurrentGameName}" Classes="secondary" />
                    <TextBlock Text="{Binding CurrentTotalText}" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="Total play time" Classes="tertiary" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="cta"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="16">
                <TextBlock Text="All games" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Totals}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pt:PlayTimeSummary">
                            <Border Classes="card" Width="310" Margin="0,0,14,14" Padding="16">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="22" />
                                        <TextBlock Text="{Binding LastPlayedText}" Classes="tertiary" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Recent sessions" Classes="h2" Margin="0,6,0,0" />
                <Border Classes="card" Padding="8">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pt:PlayTimeSession">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      Margin="12,8"
                                      ColumnSpacing="18">
                                    <TextBlock Text="{Binding StartText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DurationText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StateText}"
                                               Classes="tertiary" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="tertiary"
                           Text="Sessions are recorded by the background play-time monitor started together with the game process." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
